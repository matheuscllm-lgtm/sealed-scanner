# Python cache
__pycache__/
*.pyc
*.pyo

# Virtualenv (local interpreter — nunca commitar)
.venv/
venv/

# Secrets — NEVER commit
.env
.env.*
!.env.example
*.pem
credentials.json

# Playwright session profiles (binary state)
.pw_profile_*/

# Scanner outputs (data, logs, debug artifacts)
*.xlsx
*.log
*.html
# fixtures de teste são versionadas (HTML estável p/ travar seletores)
!tests/fixtures/*.html
*_cache.json

# Run artifacts (cada scan escreve um dir timestamped fresco)
results/
.config_local_run.yaml

# Referência eBay (lado de venda): dado volátil de PEDIDA, só gerável onde há
# EBAY_CLIENT_ID/SECRET — nunca versionar (a us_reference.json continua versionada)
data/ebay_reference*.json

# Camada de análise (hold vs sell): séries/imports/log de previsões e caches
# são DADO de mercado — fora do repo público (set_meta e events_*.yaml são
# referência curada e CONTINUAM versionados)
data/history/
data/forecasts/
data/cache/
data/terapeak/
mock_data/analysis_sim/out/

# Local-only operational / strategy notes (kept on disk, not published)
snapshots/
GOALS.md
AGENT.md
RUNBOOK.md
docs/SESSION-*.md
docs/HANDOFF-*.md
docs/archive/

# Watchdog runtime lock (PID + heartbeat — nunca commitar)
.watchdog.lock

# Draft intermediário do gerador de registry
scripts/registry_additions.yaml
